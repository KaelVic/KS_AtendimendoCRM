# Copie para .env somente na VM. Nunca versione .env.
# Valores secretos devem ser injetados a partir do SSM Parameter Store ou cofre.
ENVIRONMENT=production
PUBLIC_DOMAIN=
COMPOSE_PROFILES=

# Banco e Redis: os serviços não têm portas públicas no overlay AWS.
POSTGRES_USER=ks_user
POSTGRES_PASSWORD=
POSTGRES_DB=ks_atendimento
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379
# External PostgreSQL provider used by the pilot.
DATABASE_BACKEND=neon
DATABASE_URL=
DATABASE_SSL_MODE=auto
REDIS_URL=

# Aplicação — segredos vazios por desenho.
JWT_SECRET_KEY=
OWNER_AUTH_TOKEN=
OPENWA_API_KEY=
OPENWA_API_KEY_PEPPER=
OPENWA_API_MASTER_KEY=
OPENWA_WEBHOOK_SECRET=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SCRAPEGRAPH_SERVICE_TOKEN=

# OpenWA é opt-in. Ao ativar, use a imagem v0.23.3 com digest verificado.
ENABLE_OPENWA=0
OPENWA_IMAGE=
OPENWA_SESSION_ID=
OPENWA_DEDICATED_NUMBER_REF=
OPENWA_SHARD_ID=
OPENWA_GATEWAY_ID=00000000-0000-0000-0000-000000000002
OPENWA_OWNER_ID=ks-api-pilot
OPENWA_LEASE_SECONDS=30
OPENWA_COMMERCIAL_USE=0
OPENWA_COMMERCIAL_GATE_APPROVED=0
OPENWA_GATE_EVIDENCE_SHA256=
OPENWA_GATE_EVIDENCE_FILE=
OPENWA_VOLUME_NAME=ks_openwa_sessions
OPENWA_API_KEY_ROLE=operator
OPENWA_ALLOWED_SESSIONS=
OPENWA_ALLOWED_IPS=

# Backup privado e alertas — referências/configuração, não credenciais.
BACKUP_S3_URI=
BUDGET_NAME=ks-atendimento-piloto
BUDGET_LIMIT_USD=
BUDGET_ALERT_EMAIL=
SSM_PARAMETER_PATH=/ks-atendimento/production
