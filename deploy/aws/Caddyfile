{$PUBLIC_DOMAIN} {
    encode zstd gzip

    @api path /auth* /health* /inbox* /simulator* /pending* /proposals* /commercial* /meetings* /prospects* /outreach*
    handle @api {
        reverse_proxy api:8000
    }

    # API documentation and OpenWA administration are never routed publicly.
    handle /docs* {
        respond "Not found" 404
    }
    handle /openapi.json {
        respond "Not found" 404
    }

    handle /api/docs* {
        respond "Not found" 404
    }
    handle /api/openapi.json {
        respond "Not found" 404
    }
    handle /dashboard* {
        respond "Not found" 404
    }

    handle {
        reverse_proxy web:3000
    }
}
