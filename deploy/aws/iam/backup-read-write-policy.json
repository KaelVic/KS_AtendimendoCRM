{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyBackupPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_WITH_PRIVATE_BACKUP_BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["ks-atendimento/*"]
        }
      }
    },
    {
      "Sid": "BackupObjectsOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_PRIVATE_BACKUP_BUCKET/ks-atendimento/*"
    },
    {
      "Sid": "ReadApplicationParametersOnly",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:REPLACE_WITH_REGION:REPLACE_WITH_ACCOUNT_ID:parameter/ks-atendimento/production/*"
    }
  ]
}
