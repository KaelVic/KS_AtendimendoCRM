# ==========================================
# KS Atendimento IA — Variáveis de Ambiente
# ==========================================
# ATENÇÃO: Nunca preencha valores secretos neste arquivo de exemplo.
# Copie este arquivo para .env e preencha com valores locais seguros.

# Ambiente de Execução
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_PORT=8000
WEB_PORT=3000

# Tenant Padrão (Piloto KaelSolutions)
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
DEFAULT_TENANT_NAME=KaelSolutions
ADMIN_EMAIL=kaelvictor.devsolution@gmail.com
# Destinatário dos alertas de pendências; valor real somente no ambiente/cofre.
OWNER_ALERT_EMAIL=
# Token temporário do adapter de autenticação do proprietário; nunca versionar valor real.
OWNER_AUTH_TOKEN=
PROPOSAL_STORAGE_ROOT=./var/proposals
CONTRACT_TEMPLATE_VERSION=
PAYMENT_LINK_CONFIG_VERSION=
PAYMENT_LINK_ALLOWLIST_JSON=[]
# Assinatura de webhook fornecida pelo cofre; nunca versionar valor real.
PAYMENT_WEBHOOK_SECRET=
CALENDAR_PROVIDER=fake
GOOGLE_CALENDAR_CREDENTIALS_JSON=
CALENDAR_PERSONAL_ID=personal
CALENDAR_ONBOARDING_ID=Onboarding KaelSolutions
CALENDAR_TIMEZONE=America/Sao_Paulo
TIMEZONE=America/Sao_Paulo

# Banco de Dados Transacional (PostgreSQL)
POSTGRES_USER=ks_user
POSTGRES_PASSWORD=
POSTGRES_DB=ks_atendimento
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5434
DATABASE_URL=

# Estado Efêmero, Debounce e Filas (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6380
REDIS_URL=redis://redis:6379/0

# Segredos de Aplicação e Autenticação (JWT / Sessão)
# Gere usando: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Gemini Developer API (IA Principal)
# Obtenha na Google AI Studio. Não versione a chave.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Gateway OpenWA (WhatsApp - Profile isolado em rede interna)
# Versão fixada: v0.23.3
OPENWA_SERVER_URL=http://openwa:2785
OPENWA_LOG_LEVEL=error
OPENWA_API_KEY=
OPENWA_API_KEY_PEPPER=
OPENWA_API_MASTER_KEY=
OPENWA_WEBHOOK_SECRET=
OPENWA_SESSION_ID=kaelsolutions_pilot
OPENWA_SHARD_ID=
OPENWA_GATEWAY_ID=00000000-0000-0000-0000-000000000002
OPENWA_OWNER_ID=ks-api-pilot
OPENWA_LEASE_SECONDS=30
# Provision the integration key in OpenWA as role=operator, restricted to
# this exact session and the private ks-openwa subnet. Never put the key here.
OPENWA_API_KEY_ROLE=operator
OPENWA_ALLOWED_SESSIONS=kaelsolutions_pilot
OPENWA_ALLOWED_IPS=172.30.0.0/24
OPENWA_BODY_SIZE_LIMIT=25mb
OPENWA_INFLIGHT_BODY_BUDGET_BYTES=104857600
OPENWA_WEBHOOK_MAX_PAYLOAD_BYTES=1048576
OPENWA_WEBHOOK_MAX_PER_SESSION=16
OPENWA_WEBHOOK_DISPATCH_CONCURRENCY=4
OPENWA_RATE_LIMIT_SHORT_TTL=1000
OPENWA_RATE_LIMIT_SHORT_LIMIT=10
OPENWA_RATE_LIMIT_MEDIUM_TTL=60000
OPENWA_RATE_LIMIT_MEDIUM_LIMIT=100
OPENWA_RATE_LIMIT_LONG_TTL=3600000
OPENWA_RATE_LIMIT_LONG_LIMIT=1000
OPENWA_WS_RATE_LIMIT_FRAME_PER_SECOND=60
OPENWA_WS_RATE_LIMIT_FRAME_BURST=120
OPENWA_WS_RATE_LIMIT_HANDSHAKE_MAX=10
OPENWA_WS_RATE_LIMIT_HANDSHAKE_WINDOW_MS=60000
OPENWA_WS_MAX_SOCKETS_PER_KEY=16

# Pesquisa pública isolada (ScrapeGraphAI). Token opcional apenas para rede interna local;
# em produção, configure um valor no cofre e replique-o nos dois serviços.
SCRAPEGRAPH_SERVICE_URL=http://scrapegraph:8081
SCRAPEGRAPH_SERVICE_TOKEN=
SCRAPEGRAPH_CACHE_TTL_SECONDS=86400
SCRAPEGRAPH_MAX_PAGE_BYTES=1048576
SCRAPEGRAPH_MAX_REDIRECTS=3
SCRAPEGRAPH_TIMEOUT_SECONDS=10
SCRAPEGRAPH_DOMAIN_LIMIT=10
SCRAPEGRAPH_DOMAIN_WINDOW_SECONDS=60
SCRAPEGRAPH_LLM_PROVIDER=fake
OUTREACH_PROVIDER=fake
OUTREACH_APPROVAL_TTL_HOURS=24
OUTREACH_DAILY_LIMIT=5
OUTREACH_MIN_INTERVAL_SECONDS=300

# Integrações Futuras (Fases 4 e 6)
SMTP_HOST=
SMTP_PORT=587
EMAIL_PROVIDER=fake
SMTP_USER=
SMTP_PASSWORD=
GOOGLE_CALENDAR_CREDENTIALS_JSON=
LLM_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=12
LLM_MAX_RETRIES=2
LLM_RATE_LIMIT=30
MEDIA_MAX_BYTES=26214400
MEDIA_MAX_AUDIO_DURATION_SECONDS=900
MEDIA_MAX_IMAGE_PIXELS=25000000
MEDIA_MAX_IMAGE_DIMENSION=2048
MEDIA_RETAIN_ORIGINALS=true
