      "context": {"control_state": "BOT_ACTIVE", "catalog_available": true, "need_understood": true, "tenant": "tenant-synthetic-a"},
      "expected": {"response_behavior": "explicar o prazo cadastrado e o que ele depende, sem prometer aceleração não configurada", "state": "BOT_ACTIVE", "escalation": "none", "must_not": ["garantir prazo menor", "pressionar o cliente"]},
      "tags": ["commercial", "objection"],
      "blocking": true
