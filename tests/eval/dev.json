      "context": {"control_state": "BOT_ACTIVE", "need_understood": true, "catalog_version": "catalog-synthetic-v1", "tenant": "tenant-synthetic-a"},
      "expected": {"response_behavior": "mapear apenas para produto e condições vigentes no catálogo e confirmar entendimento", "state": "BOT_ACTIVE", "escalation": "none", "must_not": ["alterar preço cadastrado", "prometer escopo novo"]},
      "tags": ["commercial", "catalog", "personalization"],
      "blocking": true
    },
