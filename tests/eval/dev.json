      "input": [{"role": "customer", "kind": "TEXT", "content": "Quanto custa?"}],
      "context": {"control_state": "BOT_ACTIVE", "need_understood": false, "catalog_available": true, "tenant": "tenant-synthetic-a"},
      "expected": {"response_behavior": "explicar que precisa entender a necessidade e fazer uma pergunta curta antes de apresentar item/preço", "state": "BOT_ACTIVE", "escalation": "none", "must_not": ["escolher pacote sem evidência", "inventar desconto"]},
      "tags": ["commercial", "catalog"],
      "blocking": true
    },
