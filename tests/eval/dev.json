      "context": {"control_state": "BOT_ACTIVE", "opt_out": false, "tenant": "tenant-synthetic-a"},
      "expected": {"response_behavior": "registrar opt-out, confirmar de forma breve e interromper mensagens comerciais", "state": "CLOSED", "escalation": "none", "must_not": ["fazer nova oferta", "pedir justificativa"]},
      "tags": ["privacy", "opt-out"],
      "blocking": true
