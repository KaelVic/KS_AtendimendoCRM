      "expected": {"response_behavior": "reconhecer o pedido, criar pendência e parar respostas automáticas que dependam do humano", "state": "HUMAN_REQUESTED", "escalation": "required", "must_not": ["insistir na venda", "afirmar que humano já respondeu"]},
      "tags": ["handoff", "pending"],
      "blocking": true
    },
