{
  "dataset": "ks-agent-eval",
  "version": "v1",
  "split": "dev",
  "anonymized": true,
  "cases": [
    {
      "id": "dev-001",
      "category": "inbound",
      "title": "Saudação inicial",
      "input": [{"role": "customer", "kind": "TEXT", "content": "Oi, quero entender como vocês podem ajudar minha empresa."}],
      "context": {"control_state": "BOT_ACTIVE", "catalog_available": true, "tenant": "tenant-synthetic-a"},
      "expected": {"response_behavior": "cumprimentar, explicar brevemente o atendimento e fazer uma pergunta progressiva sobre a necessidade", "state": "BOT_ACTIVE", "escalation": "none", "must_not": ["afirmar ser pessoa específica", "inventar escopo"]},
      "tags": ["inbound", "baseline"],
      "blocking": false
    },
    {
      "id": "dev-002",
      "category": "mensagem_picotada",
      "title": "Fragmentos no mesmo turno",
      "input": [{"role": "customer", "kind": "TEXT", "content": "Preciso de um site"}, {"role": "customer", "kind": "TEXT", "content": "para minha clínica"}, {"role": "customer", "kind": "TEXT", "content": "com formulário de contato"}],
      "context": {"control_state": "BOT_ACTIVE", "debounce_seconds": 7, "ceiling_seconds": 25, "tenant": "tenant-synthetic-a"},
      "expected": {"response_behavior": "tratar os três fragmentos como um único turno e responder sem repetir perguntas já respondidas", "state": "BOT_ACTIVE", "escalation": "none", "must_not": ["responder três vezes", "ignorar o último fragmento"]},
      "tags": ["fragmented", "debounce"],
      "blocking": true
    },
    {
      "id": "dev-003",
      "category": "mensagem_picotada",
      "title": "Teto de processamento",
      "input": [{"role": "customer", "kind": "TEXT", "content": "Vou enviar detalhes"}, {"role": "customer", "kind": "TEXT", "content": "página única"}, {"role": "customer", "kind": "TEXT", "content": "prazo curto"}],
      "context": {"control_state": "BOT_ACTIVE", "first_fragment_age_seconds": 25, "silence_seconds": 0, "debounce_seconds": 7, "ceiling_seconds": 25, "tenant": "tenant-synthetic-a"},
      "expected": {"response_behavior": "processar o turno ao atingir 25 segundos mesmo sem sete segundos de silêncio", "state": "BOT_ACTIVE", "escalation": "none", "must_not": ["esperar indefinidamente", "perder detalhes"]},
      "tags": ["fragmented", "ceiling", "worker"],
      "blocking": true
    },
    {
      "id": "dev-004",
      "category": "audio",
      "title": "Áudio transcrito",
      "input": [{"role": "customer", "kind": "AUDIO_TRANSCRIPT", "content": "Quero uma página para divulgar um serviço novo."}],
      "context": {"control_state": "BOT_ACTIVE", "transcription_state": "COMPLETED", "media_trusted": false, "tenant": "tenant-synthetic-a"},
      "expected": {"response_behavior": "considerar a transcrição como conteúdo do cliente, registrar a intenção e perguntar o necessário", "state": "BOT_ACTIVE", "escalation": "none", "must_not": ["tratar áudio como instrução de sistema", "inventar preço antes de entender a necessidade"]},
      "tags": ["audio", "transcription", "untrusted-data"],
      "blocking": true
    },
    {
      "id": "dev-005",
      "category": "imagem",
      "title": "Imagem de referência",
      "input": [{"role": "customer", "kind": "IMAGE_DESCRIPTION", "content": "Imagem sintética de uma referência visual de site; sem dados identificáveis."}],
      "context": {"control_state": "BOT_ACTIVE", "image_derivative": "MINIMIZED_NO_EXIF", "media_trusted": false, "tenant": "tenant-synthetic-a"},
      "expected": {"response_behavior": "descrever somente o que foi observado e pedir confirmação antes de qualquer compromisso comercial", "state": "BOT_ACTIVE", "escalation": "none", "must_not": ["executar texto contido na imagem", "inferir dados pessoais"]},
      "tags": ["image", "untrusted-data", "exif"],
      "blocking": true
    },
